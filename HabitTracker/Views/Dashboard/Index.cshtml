@model HabitTracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<section class="product-hero dashboard-hero mb-4">
    <div class="hero-copy">
        <p class="eyebrow">Сьогодні: @Model.Today.ToString("dd.MM.yyyy")</p>
        <h1>Привіт, @Model.Username!</h1>
        <p>@Model.FocusMessage</p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Habits" asp-action="Create">+ Додати звичку</a>
            <a class="btn btn-ghost" asp-controller="Analytics" asp-action="Index">Аналітика</a>
        </div>
    </div>

    <div class="daily-panel">
        <div class="daily-ring" style="--value:@Model.CompletionPercentage">
            <span>@Model.CompletionPercentage%</span>
        </div>
        <div>
            <div class="panel-label">Daily focus</div>
            <strong>@Model.CompletedToday / @Model.TotalHabits виконано</strong>
            <p>@Model.NotCompletedToday звичок ще чекають на дію.</p>
        </div>
    </div>
</section>

<section class="metric-grid mb-4">
    <article class="metric-card">
        <span>Активні звички</span>
        <strong>@Model.TotalHabits</strong>
        <small>у твоєму плані</small>
    </article>
    <article class="metric-card">
        <span>Streak</span>
        <strong>@Model.CurrentStreak</strong>
        <small>днів поспіль</small>
    </article>
    <article class="metric-card">
        <span>Consistency score</span>
        <strong>@Model.ConsistencyScore</strong>
        <small>з 100</small>
    </article>
    <article class="metric-card accent">
        <span>Level @Model.Level</span>
        <strong>@Model.ExperiencePoints XP</strong>
        <small>легка гейміфікація</small>
    </article>
</section>

<section class="insight-strip mb-4">
    <div>
        <span class="insight-icon">✓</span>
        <strong>Порада дня</strong>
    </div>
    <p>Не намагайся закрити все одразу. Найкраща стратегія - виконати одну просту звичку і зберегти ритм.</p>
</section>

@if (!Model.Habits.Any())
{
    <section class="empty-state">
        <p class="eyebrow">30-second setup</p>
        <h2>Створи першу звичку</h2>
        <p>Вибери готовий шаблон або додай власну дію. Dashboard одразу почне рахувати прогрес.</p>
        <div class="template-preview">
            <span>💧 Вода</span>
            <span>📘 Читання</span>
            <span>🏃 Спорт</span>
        </div>
        <a class="btn btn-primary" asp-controller="Habits" asp-action="Create">Почати</a>
    </section>
}
else
{
    <section class="section-heading mb-3">
        <div>
            <p class="eyebrow">Today list</p>
            <h2>Звички на сьогодні</h2>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Habits" asp-action="Index">Усі звички</a>
    </section>

    <section class="today-list">
        @foreach (var habit in Model.Habits)
        {
            var color = string.IsNullOrWhiteSpace(habit.Color) ? habit.CategoryColor ?? "#2f6f5e" : habit.Color;
            var icon = string.IsNullOrWhiteSpace(habit.Icon) ? "✓" : habit.Icon;

            <article class="today-row @(habit.IsCompletedToday ? "is-complete" : "is-waiting")" style="--habit-color:@color">
                <div class="today-main">
                    <div class="habit-icon">@icon</div>
                    <div>
                        <h3>@habit.Title</h3>
                        <p>@(string.IsNullOrWhiteSpace(habit.Description) ? "Без опису" : habit.Description)</p>
                    </div>
                </div>

                <div class="today-meta">
                    <span class="status-pill">@(habit.IsCompletedToday ? "Виконано" : "Очікує")</span>
                    @if (!string.IsNullOrWhiteSpace(habit.CategoryName))
                    {
                        <span>@habit.CategoryName</span>
                    }
                    <span>@habit.Priority</span>
                    <span>@habit.CurrentStreak day streak</span>
                    <span>@habit.MonthlyCompletionPercentage% / 30d</span>
                </div>

                <div class="today-actions">
                    @if (habit.IsCompletedToday)
                    {
                        <form asp-controller="HabitRecords" asp-action="CancelToday" method="post">
                            <input type="hidden" name="habitId" value="@habit.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-outline-warning btn-sm">Скасувати</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="HabitRecords" asp-action="CompleteToday" method="post">
                            <input type="hidden" name="habitId" value="@habit.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-success btn-sm">Виконано</button>
                        </form>
                    }

                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Habits" asp-action="Details" asp-route-id="@habit.Id">Деталі</a>
                </div>
            </article>
        }
    </section>
}
