@model HabitTracker.ViewModels.HabitIndexViewModel

@{
    ViewData["Title"] = "Звички";
}

<section class="section-heading mb-3">
    <div>
        <p class="eyebrow">Habit library</p>
        <h1>Звички</h1>
        <p>Керуй власними звичками, категоріями, пріоритетами та щоденним прогресом.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Додати звичку</a>
</section>

<section class="filter-bar mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label asp-for="SearchTerm" class="form-label">Пошук</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Назва або опис..." />
        </div>
        <div class="col-md-4">
            <label asp-for="CategoryId" class="form-label">Категорія</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary">Фільтрувати</button>
        </div>
    </form>
</section>

@if (!Model.Habits.Any())
{
    <section class="empty-state">
        <p class="eyebrow">No clutter</p>
        <h2>Звичок поки немає</h2>
        <p>Почни з однієї дії, яку реально виконати сьогодні. Потім додаси аналітику і складніші цілі.</p>
        <div class="template-preview">
            <span>📘 10 сторінок</span>
            <span>💧 8 склянок води</span>
            <span>🧘 5 хвилин тиші</span>
        </div>
        <a class="btn btn-primary" asp-action="Create">Створити звичку</a>
    </section>
}
else
{
    <section class="habit-grid">
        @foreach (var habit in Model.Habits)
        {
            var color = string.IsNullOrWhiteSpace(habit.Color) ? habit.CategoryColor ?? "#2f6f5e" : habit.Color;
            var icon = string.IsNullOrWhiteSpace(habit.Icon) ? "✓" : habit.Icon;

            <article class="habit-card @(habit.IsCompletedToday ? "is-complete" : "")" style="--habit-color:@color">
                <div class="habit-card-top">
                    <div class="habit-icon">@icon</div>
                    <span class="priority-chip">@habit.Priority</span>
                </div>

                <h2>@habit.Title</h2>
                <p>@(string.IsNullOrWhiteSpace(habit.Description) ? "Без опису" : habit.Description)</p>

                <div class="habit-meta">
                    @if (!string.IsNullOrWhiteSpace(habit.CategoryName))
                    {
                        <span>@habit.CategoryName</span>
                    }
                    <span>@habit.Frequency</span>
                    <span>@(habit.IsCompletedToday ? "Сьогодні виконано" : "Сьогодні очікує")</span>
                </div>

                <div class="mini-progress">
                    <div>
                        <span>30 days</span>
                        <strong>@habit.MonthlyCompletionPercentage%</strong>
                    </div>
                    <div class="progress">
                        <div class="progress-bar" style="width:@habit.MonthlyCompletionPercentage%;"></div>
                    </div>
                </div>

                <div class="habit-actions">
                    @if (habit.IsCompletedToday)
                    {
                        <form asp-controller="HabitRecords" asp-action="CancelToday" method="post">
                            <input type="hidden" name="habitId" value="@habit.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-outline-warning btn-sm">Скасувати</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="HabitRecords" asp-action="CompleteToday" method="post">
                            <input type="hidden" name="habitId" value="@habit.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-success btn-sm">Виконано</button>
                        </form>
                    }

                    <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@habit.Id">Деталі</a>
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@habit.Id">Редагувати</a>
                    <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@habit.Id">Видалити</a>
                </div>
            </article>
        }
    </section>
}
