@model HabitTracker.ViewModels.HabitFormViewModel

<form method="post" novalidate>
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Назва</label>
        <input asp-for="Title" class="form-control" placeholder="Наприклад: Вивчати C# 30 хвилин" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Опис</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Короткий опис або мотивація"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="HabitCategoryId" class="form-label">Категорія</label>
            <select asp-for="HabitCategoryId" asp-items="Model.Categories" class="form-select"></select>
            <span asp-validation-for="HabitCategoryId" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Frequency" class="form-label">Частота</label>
            <select asp-for="Frequency" asp-items="Html.GetEnumSelectList<HabitFrequency>()" class="form-select"></select>
            <span asp-validation-for="Frequency" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Priority" class="form-label">Пріоритет</label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<HabitPriority>()" class="form-select"></select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <label asp-for="Color" class="form-label">Колір</label>
            <input asp-for="Color" class="form-control" placeholder="#1c7ed6" />
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Icon" class="form-label">Іконка</label>
            <input asp-for="Icon" class="form-control" placeholder="book, sport, water..." />
            <span asp-validation-for="Icon" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>
    </div>
</form>
