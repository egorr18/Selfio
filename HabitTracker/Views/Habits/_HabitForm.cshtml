@model HabitTracker.ViewModels.HabitFormViewModel

<form method="post" novalidate class="habit-form">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <section class="template-picker compact mb-3">
        <div>
            <p class="eyebrow">Habit templates</p>
            <h2>Швидкий старт</h2>
            <p>Обери шаблон або заповни власну звичку вручну.</p>
        </div>
        <div class="template-grid">
            <button type="button" class="template-card" data-title="Пити воду" data-description="Випити 8 склянок води протягом дня." data-icon="W" data-color="#1c7ed6" data-priority="2">
                <span>W</span>
                <strong>Вода</strong>
            </button>
            <button type="button" class="template-card" data-title="Читати 10 сторінок" data-description="Прочитати мінімум 10 сторінок книги або навчального матеріалу." data-icon="B" data-color="#7048e8" data-priority="2">
                <span>B</span>
                <strong>Читання</strong>
            </button>
            <button type="button" class="template-card" data-title="Тренування" data-description="Зробити коротке тренування або прогулянку." data-icon="R" data-color="#2f9e44" data-priority="3">
                <span>R</span>
                <strong>Спорт</strong>
            </button>
            <button type="button" class="template-card" data-title="Вивчати C#" data-description="Приділити 30 хвилин практиці C# або роботі над курсовим проєктом." data-icon="C#" data-color="#f08c00" data-priority="3">
                <span>C#</span>
                <strong>Навчання</strong>
            </button>
        </div>
    </section>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Назва</label>
        <input asp-for="Title" class="form-control" placeholder="Наприклад: Вивчати C# 30 хвилин" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Опис</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Короткий опис або мотивація"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="HabitCategoryId" class="form-label">Категорія</label>
            <select asp-for="HabitCategoryId" asp-items="Model.Categories" class="form-select"></select>
            <span asp-validation-for="HabitCategoryId" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Frequency" class="form-label">Частота</label>
            <select asp-for="Frequency" asp-items="Html.GetEnumSelectList<HabitFrequency>()" class="form-select"></select>
            <span asp-validation-for="Frequency" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Priority" class="form-label">Пріоритет</label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<HabitPriority>()" class="form-select"></select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <label asp-for="Color" class="form-label">Колір</label>
            <div class="color-picker-row">
                <input asp-for="Color" class="form-control" placeholder="#1c7ed6" />
                <button type="button" class="color-dot" style="--dot:#1c7ed6" data-color="#1c7ed6" aria-label="Синій"></button>
                <button type="button" class="color-dot" style="--dot:#2f9e44" data-color="#2f9e44" aria-label="Зелений"></button>
                <button type="button" class="color-dot" style="--dot:#f08c00" data-color="#f08c00" aria-label="Жовтий"></button>
                <button type="button" class="color-dot" style="--dot:#7048e8" data-color="#7048e8" aria-label="Фіолетовий"></button>
            </div>
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Icon" class="form-label">Іконка або коротка мітка</label>
            <input asp-for="Icon" class="form-control" placeholder="W, B, R, C#, 10m..." />
            <span asp-validation-for="Icon" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>
    </div>
</form>
