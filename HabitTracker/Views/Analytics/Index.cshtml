@model HabitTracker.ViewModels.AnalyticsViewModel

@{
    ViewData["Title"] = "Аналітика";
}

<section class="section-heading mb-3">
    <div>
        <p class="eyebrow">Insights</p>
        <h1>Аналітика</h1>
        <p>Статистика виконання звичок станом на @Model.Today.ToString("dd.MM.yyyy").</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
</section>

@if (Model.TotalHabits == 0)
{
    <section class="empty-state">
        <p class="eyebrow">Analytics starts with action</p>
        <h2>Аналітика ще недоступна</h2>
        <p>Створи хоча б одну звичку, щоб система почала рахувати прогрес, streak і слабкі місця.</p>
        <a class="btn btn-primary" asp-controller="Habits" asp-action="Create">Додати звичку</a>
    </section>
}
else
{
    <section class="metric-grid mb-4">
        <article class="metric-card">
            <span>Daily completion</span>
            <strong>@Model.DailyCompletionPercentage%</strong>
            <small>@Model.CompletedToday / @Model.TotalHabits виконано сьогодні</small>
        </article>
        <article class="metric-card">
            <span>Weekly success</span>
            <strong>@Model.WeeklyCompletionPercentage%</strong>
            <small>@Model.WeeklyCompletedRecords / @Model.WeeklyPossibleRecords за 7 днів</small>
        </article>
        <article class="metric-card">
            <span>Monthly success</span>
            <strong>@Model.MonthlyCompletionPercentage%</strong>
            <small>@Model.MonthlyCompletedRecords / @Model.MonthlyPossibleRecords за 30 днів</small>
        </article>
        <article class="metric-card accent">
            <span>Current streak</span>
            <strong>@Model.CurrentStreak</strong>
            <small>днів поспіль</small>
        </article>
    </section>

    <section class="analytics-layout mb-4">
        <article class="insight-card">
            <p class="eyebrow">Weekly rhythm</p>
            <h2>Тижневий ритм</h2>
            <p>@Model.WeeklyInsight</p>
            <div class="week-bars">
                @foreach (var day in Model.WeeklyActivity)
                {
                    <div class="week-day">
                        <div class="bar-track">
                            <div class="bar-fill" style="height:@Math.Max(day.Percentage, 4)%;"></div>
                        </div>
                        <strong>@day.Percentage%</strong>
                        <span>@day.Date.ToString("dd.MM")</span>
                    </div>
                }
            </div>
        </article>

        <article class="insight-card">
            <p class="eyebrow">Smart insight</p>
            <h2>Що робити далі</h2>
            <p>@Model.MonthlyInsight</p>

            <div class="best-weak-grid">
                <div>
                    <span>Best habit</span>
                    @if (Model.BestHabit is null)
                    {
                        <strong>-</strong>
                    }
                    else
                    {
                        <strong>@Model.BestHabit.Title</strong>
                        <small>@Model.BestHabit.CompletionPercentage% за 30 днів</small>
                    }
                </div>
                <div>
                    <span>Needs attention</span>
                    @if (Model.WeakHabit is null)
                    {
                        <strong>-</strong>
                    }
                    else
                    {
                        <strong>@Model.WeakHabit.Title</strong>
                        <small>@Model.WeakHabit.CompletionPercentage% за 30 днів</small>
                    }
                </div>
            </div>
        </article>
    </section>

    <section class="data-card">
        <div class="section-heading compact">
            <div>
                <p class="eyebrow">Habit performance</p>
                <h2>Прогрес за звичками</h2>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Звичка</th>
                    <th>Виконано</th>
                    <th>Період</th>
                    <th>Відсоток</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var habit in Model.HabitPerformances)
                {
                    <tr>
                        <td>@habit.Title</td>
                        <td>@habit.CompletedDays</td>
                        <td>@habit.TrackedDays днів</td>
                        <td style="min-width:180px;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 10px;">
                                    <div class="progress-bar" style="width:@habit.CompletionPercentage%;"></div>
                                </div>
                                <span>@habit.CompletionPercentage%</span>
                            </div>
                        </td>
                        <td>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Habits" asp-action="Details" asp-route-id="@habit.HabitId">Деталі</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
